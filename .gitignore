# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# dev logs
dev_server.log

# one-off diagnostic/fix scripts (see AUTOMATION_DOCUMENTATION.md)
scripts/check_*.py
scripts/fix_*.py
scripts/verify_*.py
scripts/scan_*.py
scripts/final_check.py
scripts/regen_*.py
scripts/extend_*.py

scripts/diag_*.py
scripts/cleanup_*.py
scripts/final_*.py

# temp diagnostic outputs
*_out.txt
*_err.txt
